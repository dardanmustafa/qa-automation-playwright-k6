# --- UI tests (PrestaShop) ---
# Leave empty to create a fresh shop on demo.prestashop.com for every run.
# Set it to test an existing shop instead, e.g. a local PrestaShop in Docker.
SHOP_URL=

# --- API tests (OpenStreetMap development server) ---
# OAuth 2.0 access token for https://master.apis.dev.openstreetmap.org with the
# "write_api" and "write_notes" scopes. Tests that need it are skipped while it is empty.
# `npm run osm:token -- <client-id>` fills in both values for you.
OSM_CLIENT_ID=
OSM_ACCESS_TOKEN=
